{
  "name": "pknstan-library-system",
  "version": "3.0.0",
  "private": true,
  "description": "Sistem Informasi Operasional Perpustakaan PKN STAN - Vercel/GitHub deployment ready",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/local-server.js",
    "dev": "node --watch scripts/local-server.js",
    "test": "node --test tests/*.test.js",
    "check": "node src/scripts/checkJs.js",
    "verify": "npm run check && npm test",
    "db:migrate": "node src/scripts/migrateDb.js",
    "db:seed": "node src/scripts/seedDb.js",
    "db:init": "node src/scripts/initDb.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  }
}
